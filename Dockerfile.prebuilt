# syntax=docker/dockerfile:1
#
# Lucky 运行镜像（预编译二进制版）。
# CI 用它：linux/amd64 与 linux/arm64 的二进制由 `binaries` job 交叉编译好后放进
# dist/<TARGETARCH>/lucky，这里只装运行时工具 + 拷二进制，不做前端/Go 构建，
# 因此多架构构建只需跑一层 apt，速度快、不需要在 QEMU 里编译。
#
# 本地想用这个 Dockerfile，先准备好二进制：
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -tags embedui -o dist/amd64/lucky ./cmd/artex
#   docker build -f Dockerfile.prebuilt --build-arg TARGETARCH=amd64 -t lucky:local .

FROM debian:bookworm-slim
ARG TARGETARCH
ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget jq unzip git tzdata \
      ripgrep dnsutils iputils-ping netcat-openbsd whois nmap \
      python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY dist/${TARGETARCH}/lucky /app/lucky
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
RUN chmod +x /app/lucky /app/start.sh && mkdir -p /app/data

VOLUME ["/app/data"]
EXPOSE 8787 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8787/ >/dev/null || exit 1

ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]